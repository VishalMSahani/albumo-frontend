{
  "name": "albumo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.json\" \"*.mjs\" \"*.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.json\" \"*.mjs\" \"*.md\"",
    "test:integration": "node --test scripts/integration.test.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "assets:preview": "cd ../backend && node --env-file=.env --import tsx scripts/sync-static-assets.mts",
    "assets:publish": "cd ../backend && node --env-file=.env --import tsx scripts/sync-static-assets.mts --apply --verify",
    "prebuild": "node scripts/check-cdn-assets.mjs",
    "test:checkout": "node scripts/checkout-browser.mjs"
  },
  "dependencies": {
    "@albumo/tokens": "file:../packages/albumo-tokens",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-aria-components": "1.21.1",
    "react-dom": "19.2.4",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "postcss": "^8.5.29",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  }
}
