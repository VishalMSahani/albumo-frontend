# Public API origin only. Never add database or service secrets here.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_STUDIO_URL=http://localhost:3001
# Production example: https://api.albumo.in
NEXT_PUBLIC_LEGAL_ENTITY_NAME=Albumo Studio Pvt Ltd

# Public image domain only. R2 credentials stay in backend/.env.
NEXT_PUBLIC_CDN_BASE_URL=https://cdn.albumo.in

# Optional official Facebook profile URL. Leave empty until confirmed.
# Only HTTPS Facebook profile URLs are accepted; the unset pill is disabled.
# Instagram and YouTube use the saved links in src/features/contact/social-links.ts.
# WhatsApp uses /api/contact/settings.
NEXT_PUBLIC_FACEBOOK_URL=
